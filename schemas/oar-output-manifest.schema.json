{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stances-framework:schema:oar-output-manifest:1",
  "title": "Stances Framework OAR Output Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "packageVersion",
    "generatorVersion",
    "outputRoot",
    "files",
    "submods",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "generatorVersion": {
      "type": "string",
      "minLength": 1
    },
    "frameworkVersion": {
      "type": "string",
      "minLength": 1
    },
    "outputRoot": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "submods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/submod"
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors",
        "warnings",
        "unknowns"
      ],
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source",
        "digest",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "submod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "animationSetId",
        "canonicalNodeId",
        "view",
        "matchMode",
        "configPath",
        "animationFiles",
        "priority"
      ],
      "properties": {
        "animationSetId": {
          "type": "string",
          "minLength": 1
        },
        "canonicalNodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*:[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "view": {
          "type": "string",
          "enum": [
            "first-person",
            "third-person"
          ]
        },
        "matchMode": {
          "type": "string",
          "enum": [
            "exact",
            "inherited"
          ]
        },
        "configPath": {
          "type": "string",
          "minLength": 1
        },
        "animationFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    }
  }
}
