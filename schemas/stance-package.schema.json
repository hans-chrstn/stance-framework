{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stances-framework:schema:stance-package:1",
  "title": "Stances Framework Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "packageVersion",
    "displayName",
    "trees"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "frameworkRequirement": {
      "$ref": "#/$defs/versionRequirement"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "trees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tree"
      }
    },
    "animationSets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/animationSet"
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patch"
      }
    }
  },
  "$defs": {
    "versionRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "versionRange"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "versionRange": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "versionRange"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "versionRange": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treeId",
        "displayName",
        "defaultNode",
        "nodes"
      ],
      "properties": {
        "treeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "defaultNode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "defaultChildPolicy": {
          "type": "string",
          "enum": [
            "none",
            "configured-child",
            "remembered-child"
          ],
          "default": "none"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "displayName",
        "parent",
        "order",
        "unlock"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "order": {
          "type": "integer"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "unlock": {
          "oneOf": [
            {
              "$ref": "#/$defs/alwaysUnlock"
            },
            {
              "$ref": "#/$defs/singleNodeUnlock"
            },
            {
              "$ref": "#/$defs/multipleNodeUnlock"
            }
          ]
        }
      }
    },
    "alwaysUnlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "always"
        }
      }
    },
    "singleNodeUnlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "node"
      ],
      "properties": {
        "mode": {
          "const": "requires-unlocked-node"
        },
        "node": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "multipleNodeUnlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "nodes"
      ],
      "properties": {
        "mode": {
          "const": "requires-multiple-unlocked-nodes"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "animationSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "animationSetId",
        "treeId",
        "node",
        "view",
        "source",
        "matchMode"
      ],
      "properties": {
        "animationSetId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "treeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "node": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "view": {
          "type": "string",
          "enum": [
            "first-person",
            "third-person"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/|\\\\)\\.\\.(?:/|\\\\|$)).+$"
        },
        "matchMode": {
          "type": "string",
          "enum": [
            "exact",
            "inherited"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "oarConditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patchId",
        "target",
        "operations",
        "conflictPolicy"
      ],
      "properties": {
        "patchId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "target": {
          "$ref": "#/$defs/versionRequirement"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "conflictPolicy": {
          "type": "string",
          "enum": [
            "stop-on-precondition-failure",
            "report-only"
          ]
        }
      }
    }
  }
}
