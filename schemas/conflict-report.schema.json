{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stances-framework:schema:conflict-report:1",
  "title": "Stances Framework Conflict Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "status",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "clean",
        "review",
        "blocked"
      ]
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    }
  },
  "$defs": {
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflictId",
        "kind",
        "severity",
        "certainty",
        "message",
        "owners",
        "targets",
        "evidence",
        "requiresApproval"
      ],
      "properties": {
        "conflictId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "package-identity",
            "tree-graph",
            "unlock-graph",
            "asset-ownership",
            "oar-selector",
            "external-condition",
            "runtime-integration"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "unknown",
            "requires-approval"
          ]
        },
        "certainty": {
          "type": "string",
          "enum": [
            "proven",
            "probable",
            "unknown"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "requiresApproval": {
          "type": "boolean"
        },
        "proposedResolution": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "patch",
                "rename",
                "priority-change",
                "remove-overlap",
                "manual-decision"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "patchPath": {
              "type": "string",
              "minLength": 1
            },
            "preconditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "location",
        "observation"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
